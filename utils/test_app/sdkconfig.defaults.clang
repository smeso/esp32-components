CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_CXX_EXCEPTIONS=y
CONFIG_COMPILER_CXX_EXCEPTIONS_EMG_POOL_SIZE=512
CONFIG_COMPILER_STACK_CHECK_MODE_ALL=y
CONFIG_COMPILER_WARN_WRITE_STRINGS=y
# esp-clang does not support -print-sysroot, which the reproducible-build
# prefix map generation invokes (tools/cmake/prefix_map.cmake).
CONFIG_APP_REPRODUCIBLE_BUILD=n
