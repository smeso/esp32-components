# leds_effects' transition task uses cppTaskCreate(), whose trampoline needs a
# working try/catch to contain the callable's exceptions.
CONFIG_COMPILER_CXX_EXCEPTIONS=y
# cppTaskCreate() keeps each task's callable at thread local storage index 1:
# index 0 is reserved by ESP-IDF for the pthreads API, which the C++ exception
# machinery uses. Two pointers are therefore required.
CONFIG_FREERTOS_THREAD_LOCAL_STORAGE_POINTERS=2
CONFIG_FREERTOS_HZ=200
