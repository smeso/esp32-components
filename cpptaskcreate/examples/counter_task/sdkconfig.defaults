# The task entry point catches uncaught exceptions with try/catch and the
# test suite exercises the throw path.
CONFIG_COMPILER_CXX_EXCEPTIONS=y
# cppTaskCreate() keeps each task's callable at thread local storage index 1:
# index 0 is reserved by ESP-IDF for the pthreads API, so two pointers are
# required.
CONFIG_FREERTOS_THREAD_LOCAL_STORAGE_POINTERS=2
